unit matio.formats.cube;

////////////////////////////////////////////////////////////////////////////////
//
// Author: Jaap Baak
// https://github.com/transportmodelling/matio
//
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
interface
////////////////////////////////////////////////////////////////////////////////

Uses
  matio.formats.hdf5, matio.reader.hdf5.cube, matio.writer.hdf5.cube;

Type
  TCubeMatrixReaderFormat = Class(THdf5MatrixReaderFormat)
  public
    Constructor Create;
  end;

  TCubeMatrixWriterFormat = Class(THdf5MatrixWriterFormat)
  public
    Constructor Create;
  end;

////////////////////////////////////////////////////////////////////////////////
implementation
////////////////////////////////////////////////////////////////////////////////

Constructor TCubeMatrixReaderFormat.Create;
begin
  inherited Create('cube','Cube','.Cube-matrix',TCubeMatrixReader);
end;

////////////////////////////////////////////////////////////////////////////////

Constructor TCubeMatrixWriterFormat.Create;
begin
  inherited Create('cube','Cube',TCubeMatrixWriter);
end;

end.

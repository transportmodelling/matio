unit matio.formats.omx;

////////////////////////////////////////////////////////////////////////////////
//
// Author: Jaap Baak
// https://github.com/transportmodelling/matio
//
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
interface
////////////////////////////////////////////////////////////////////////////////

Uses
  matio.formats.hdf5, matio.reader.hdf5.omx, matio.writer.hdf5.omx;

Type
  TOMXMatrixReaderFormat = Class(THdf5MatrixReaderFormat)
  public
    Constructor Create;
  end;

  TOMXMatrixWriterFormat = Class(THdf5MatrixWriterFormat)
  public
    Constructor Create;
  end;

////////////////////////////////////////////////////////////////////////////////
implementation
////////////////////////////////////////////////////////////////////////////////

Constructor TOMXMatrixReaderFormat.Create;
begin
  inherited Create('omx','Open Matrix Format','.omx',TOMXMatrixReader);
end;

////////////////////////////////////////////////////////////////////////////////

Constructor TOMXMatrixWriterFormat.Create;
begin
  inherited Create('omx','Open Matrix Format',TOMXMatrixWriter);
end;

end.
